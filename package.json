{
  "name": "lmessage-tracker",
  "productName": "HOTIT Manager",
  "version": "3.9.0",
  "description": "Run your IT business: customers, assets, finances, goals and plans, and notes.",
  "main": "main.js",
  "author": "James Clarke",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.jamesdavidclarke.lmessagetracker",
    "productName": "HOTIT Manager",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "db.js",
      "vault.js",
      "cryptfile.js",
      "totp.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HOTIT Manager"
    },
    "portable": {
      "artifactName": "HOTITManager-Portable-${version}.exe"
    }
  }
}
